    "mismatched_mechanism_code_forbidden": true
  },
  "proposed_scoring_weights": {
    "intent_accuracy": 0.1,
    "retrieval_relevance": 0.15,
    "corpus_grounding": 0.25,
    "citation_integrity": 0.15,
    "terminology_integrity": 0.1,
    "content_coverage": 0.15,
