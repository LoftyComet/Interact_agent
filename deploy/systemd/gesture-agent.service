[Unit]
Description=Gesture Agent Web Backend
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/Interact_agent
EnvironmentFile=/root/Interact_agent/.env
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=5000
ExecStart=/root/Interact_agent/.venv/bin/python -m web.backend.app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
